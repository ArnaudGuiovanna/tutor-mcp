# Stable source line endings for Windows builds and Linux WSL scripts.
client/** text eol=lf
# Retain the model author's exact original license bytes.
client/local-agent/notices/QWEN-LICENSE.txt -text -whitespace
client/src-tauri/icons/*.png -text
client/src-tauri/icons/*.ico -text
# Preserve the SDK's original legal text, including its original trailing space.
client/scripts/notices-supplements/** -text
client/scripts/notices-supplements/nsis-3.13/** whitespace=cr-at-eol
client/scripts/notices-supplements/microsoft-webview2-sdk-1.0.3800.47/LICENSE.txt -whitespace
# This script is executed by Linux Bash from a Windows checkout.
client/tests/windows/setup-wsl-runtime.sh text eol=lf
client/scripts/notices-supplements/nsis-3.13/COPYING -whitespace
# Original upstream license files end with a blank line; keep their exact bytes.
client/scripts/notices-supplements/bitcoin-io-0.1.3/LICENSE -whitespace
client/scripts/notices-supplements/bitcoin_hashes-0.14.0/LICENSE -whitespace
# Preserve the CRLF line endings from the verified Windows ripgrep archive.
client/scripts/notices-supplements/codex-0.160.1/ripgrep-COPYING whitespace=cr-at-eol
client/scripts/notices-supplements/codex-0.160.1/ripgrep-LICENSE-MIT whitespace=cr-at-eol
client/scripts/notices-supplements/codex-0.160.1/ripgrep-UNLICENSE whitespace=cr-at-eol
