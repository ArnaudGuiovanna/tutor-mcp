[Unit]
Description=TUTOR MCP hobby server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tutor
Group=tutor
StateDirectory=tutor-mcp
StateDirectoryMode=0700
WorkingDirectory=/var/lib/tutor-mcp
ExecStart=/usr/local/bin/tutor-mcp --profile hobby --data-dir /var/lib/tutor-mcp/hobby
Environment=PORT=3000
Environment=TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
Restart=on-failure
RestartSec=5s
# Graceful HTTP drain = max(30s, MCP_TOOL_CALL_TIMEOUT_SECONDS + 10s), then
# cleanup; keep this above it (docs/configuration.md).
TimeoutStopSec=50s

[Install]
WantedBy=multi-user.target
