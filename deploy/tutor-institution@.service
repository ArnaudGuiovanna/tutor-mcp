[Unit]
Description=TUTOR MCP institutional %i process
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tutor-%i
Group=tutor-%i
EnvironmentFile=/etc/tutor-mcp/%i.env
Environment=PROCESS_ROLE=%i
ExecStart=/usr/local/bin/tutor-mcp --profile institution
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
Restart=on-failure
RestartSec=5s
# Graceful HTTP drain = max(30s, MCP_TOOL_CALL_TIMEOUT_SECONDS + 10s), then
# cleanup; keep this above it (docs/configuration.md).
TimeoutStopSec=50s

[Install]
WantedBy=multi-user.target
