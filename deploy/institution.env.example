# Copy separately to api.env, worker.env and migrator.env, private to each role.
# Each DATABASE_URL must use its own login and role grants; never share owner credentials.
DATABASE_URL=postgres://ROLE_LOGIN:URL_ENCODED_PASSWORD@db.example.org/tutor?sslmode=verify-full&sslrootcert=/etc/tutor-mcp/secrets/postgres-ca.pem
BASE_URL=https://tutor.example.org
PORT=3000
RATELIMIT_BACKEND=postgres
SCHEDULER_MODE=distributed
OAUTH_DCR_MODE=disabled
TUTOR_MCP_MEMORY_BACKEND=database
TUTOR_MCP_MEMORY_ROOT=/nonexistent
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# API only: exact ID returned by tutor-control-plane -action=provision.
# Bootstrap its owner with the client's public active/recovery npubs.
INSTITUTION_ID=
INSTITUTION_NAME=
# JSON array: kid, public_key (base64), private_key (base64 seed), active.
# Required only by API; use operator-managed Ed25519 keys and rotation.
JWT_ED25519_KEYS=
INTEGRATION_SECRET_KEYS=
INTEGRATION_SECRET_CURRENT_KEY_ID=
TENANT_INTEGRATION_ALLOWED_HOSTS=discord.com
