{
  "name": "@tutor-mcp/site",
  "private": true,
  "version": "0.7.0",
  "description": "tutor-mcp.dev \u2014 static Next.js site following the Tutor-MCP charter",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "preview": "python3 -m http.server 18765 --bind 127.0.0.1 --directory out",
    "sync-releases": "node --experimental-strip-types scripts/sync-releases.mjs",
    "test": "node --experimental-strip-types --test tests/releases.test.mjs",
    "check:export": "python3 scripts/check_export.py",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module"
}
